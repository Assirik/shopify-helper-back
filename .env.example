PORT=3600
NODE_ENV=development
API_ENDPOINT=http://localhost:3600

# MongoDB Atlas connection string. MongoDB is not started by Docker Compose.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/shopify-order-handler

JWT_SECRET=change-me

SHOPIFY_WEBHOOK_SECRET=change-me
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com

META_WHATSAPP_ACCESS_TOKEN=change-me
META_WHATSAPP_PHONE_NUMBER_ID=change-me
META_WHATSAPP_TEMPLATE_NAME=order_confirmation
META_WHATSAPP_TEMPLATE_LANGUAGE=fr

TERMII_API_KEY=change-me
TERMII_SENDER_ID=YourShop
TERMII_BASE_URL=https://v3.api.termii.com

REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379

# Origines frontend autorisees, separees par des virgules.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

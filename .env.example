PORT=3600
NODE_ENV=development
API_ENDPOINT=http://localhost:3600
# URLs affichées dans Swagger. Laisser vide lorsqu'un environnement n'existe pas.
NGROK_ENDPOINT=
PRODUCTION_API_ENDPOINT=

# MongoDB Atlas connection string. MongoDB is not started by Docker Compose.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/shopify-order-handler

JWT_SECRET=change-me

# Secret temporaire de 32 caracteres minimum pour POST /api/auth/bootstrap.
INITIAL_ADMIN_BOOTSTRAP_SECRET=

SHOPIFY_WEBHOOK_SECRET=change-me
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com

META_WHATSAPP_ACCESS_TOKEN=change-me
META_WHATSAPP_APP_SECRET=change-me
META_WHATSAPP_PHONE_NUMBER_ID=change-me
# WhatsApp Business Account (WABA) ID, requis pour lister/gerer les templates.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
META_WHATSAPP_TEMPLATE_NAME=order_confirm_auto_schedule
META_WHATSAPP_CONFIRMED_TEMPLATE_NAME=order_confirmed
# Nom du template d'annulation valide chez Meta. Laisser vide pour annuler sans
# notifier le client.
META_WHATSAPP_CANCELLED_TEMPLATE_NAME=order_canceled_by_admin
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
META_WHATSAPP_TEMPLATE_LANGUAGE=fr
META_WHATSAPP_GRAPH_API_VERSION=v20.0

TERMII_API_KEY=change-me
TERMII_SENDER_ID=YourShop
TERMII_BASE_URL=https://v3.api.termii.com

# Workflow de confirmation: relances automatiques et expiration (en heures depuis la creation).
CONFIRMATION_FIRST_REMINDER_HOURS=24
CONFIRMATION_SECOND_REMINDER_HOURS=48
CONFIRMATION_EXPIRE_HOURS=72
CONFIRMATION_MAX_REMINDERS=2
# Delai minimal entre deux relances (manuelles ou auto) sur une meme commande.
CONFIRMATION_REMINDER_COOLDOWN_MINUTES=60
# Frequence du balayage automatique des commandes en attente.
CONFIRMATION_SWEEP_INTERVAL_MINUTES=30

# Remuneration livreur par defaut quand aucun bareme regional n'est configure.
DELIVERY_DEFAULT_FEE=0

REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@redis:6379

# Origines frontend autorisees, separees par des virgules.
ALLOWED_ORIGINS=http://localhost:5173

PORT=3600
NODE_ENV=development
API_ENDPOINT=http://localhost:3600
# URLs affichées dans Swagger. Laisser vide lorsqu'un environnement n'existe pas.
NGROK_ENDPOINT=
PRODUCTION_API_ENDPOINT=

# MongoDB Atlas connection string. MongoDB is not started by Docker Compose.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/shopify-order-handler

JWT_SECRET=change-me

# Secret temporaire de 32 caracteres minimum pour POST /api/auth/bootstrap.
INITIAL_ADMIN_BOOTSTRAP_SECRET=

SHOPIFY_WEBHOOK_SECRET=change-me
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com

META_WHATSAPP_ACCESS_TOKEN=change-me
META_WHATSAPP_APP_SECRET=change-me
META_WHATSAPP_PHONE_NUMBER_ID=change-me
# WhatsApp Business Account (WABA) ID, requis pour lister/gerer les templates.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=change-me
META_WHATSAPP_TEMPLATE_NAME=order_confirm_auto_schedule
META_WHATSAPP_CONFIRMED_TEMPLATE_NAME=order_confirmed
# Nom du template d'annulation valide chez Meta. Laisser vide pour annuler sans
# notifier le client.
META_WHATSAPP_CANCELLED_TEMPLATE_NAME=order_canceled_by_admin
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
META_WHATSAPP_TEMPLATE_LANGUAGE=fr
META_WHATSAPP_GRAPH_API_VERSION=v26.0

# Meta Conversions API (envoi de l'achat a Meta a la confirmation). Coupe par defaut :
# seul META_CAPI_ENABLED=true l'active, et exige alors dataset et jeton.
META_CAPI_ENABLED=false
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_GRAPH_API_VERSION=v26.0
# Taux XOF pour 1 EUR (parite fixe). Valeur absente ou invalide : 655.957.
META_CAPI_FX_XOF_EUR=655.957
# Code d'evenement de test Meta (optionnel, vide en production).
META_CAPI_TEST_EVENT_CODE=

# Domaines de la boutique autorises a envoyer les infos navigateur a POST /api/session
# (script du theme), separes par des virgules, avec le schema, sans chemin.
# Ex: https://ma-boutique.com,https://www.ma-boutique.com
# Vide : la route refuse tous les envois.
SESSION_CAPTURE_ALLOWED_ORIGINS=

# Chatwoot (miroir des conversations WhatsApp). Laisser CHATWOOT_URL vide pour
# desactiver le forward. Le backend reste le SEUL webhook Meta et relaie le payload
# brut vers POST {CHATWOOT_URL}/webhooks/whatsapp/{CHATWOOT_WHATSAPP_PHONE_NUMBER}.
CHATWOOT_URL=
# Numero E.164 de l'inbox WhatsApp Chatwoot (ex: +221703775324) — le NUMERO, pas le phone_number_id.
CHATWOOT_WHATSAPP_PHONE_NUMBER=
# Secret pour signer X-Hub-Signature-256 vers Chatwoot. Par defaut, reutilise META_WHATSAPP_APP_SECRET.
CHATWOOT_META_APP_SECRET=
# Token API Chatwoot (profil agent/admin) pour le miroir sortant des templates.
# Laisser vide pour desactiver le miroir sortant (le forward entrant reste actif).
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=

TERMII_API_KEY=change-me
TERMII_SENDER_ID=YourShop
TERMII_BASE_URL=https://v3.api.termii.com

# Workflow de confirmation: relances automatiques et expiration (en heures depuis la creation).
CONFIRMATION_FIRST_REMINDER_HOURS=24
CONFIRMATION_SECOND_REMINDER_HOURS=48
CONFIRMATION_EXPIRE_HOURS=72
CONFIRMATION_MAX_REMINDERS=2
# Delai minimal entre deux relances (manuelles ou auto) sur une meme commande.
CONFIRMATION_REMINDER_COOLDOWN_MINUTES=60
# Frequence du balayage automatique des commandes en attente.
CONFIRMATION_SWEEP_INTERVAL_MINUTES=30

# Remuneration livreur par defaut quand aucun bareme regional n'est configure.
DELIVERY_DEFAULT_FEE=0

# Cout transporteur tiers par defaut (livraison hors Dakar), pre-rempli a la livraison.
DELIVERY_DEFAULT_CARRIER_FEE=2000

REDIS_URL=redis://:redis_password@redis:6379

# Origines frontend autorisees, separees par des virgules.
ALLOWED_ORIGINS=http://localhost:5173
